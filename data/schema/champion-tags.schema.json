{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-advisor.local/schema/champion-tags.schema.json",
  "title": "Generic champion profiles (data/champions/tags.json)",
  "description": "One entry per champion. Used for the generic fallback score/advice and role inference when no curated matchup exists.",
  "type": "object",
  "required": ["champions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "champions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "common.schema.json#/$defs/championId" },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["damage", "range", "mobility", "typicalRoles", "cc", "traits", "earlyGame"],
      "additionalProperties": false,
      "properties": {
        "damage": { "$ref": "common.schema.json#/$defs/damageType" },
        "range": { "enum": ["melee", "ranged"] },
        "mobility": { "enum": ["low", "medium", "high"] },
        "typicalRoles": {
          "description": "Most common first. Used for role inference when champ select has no assignedPosition.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/role" }
        },
        "cc": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ccType" } },
        "traits": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/tag" } },
        "earlyGame": {
          "description": "Early laning/skirmish strength: 1 = weak early, 2 = average, 3 = strong early. Used for lane priority.",
          "enum": [1, 2, 3]
        },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    }
  }
}
