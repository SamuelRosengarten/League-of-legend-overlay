{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-advisor.local/schema/item-counters.schema.json",
  "title": "Items that matter for Gwen/Amumu matchups (data/items/counters.json)",
  "description": "When an enemy owns one of these items in game, its `effects` tags are added to that enemy (re-ranking the threat list).",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]{3,5}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "effects", "relevantTo", "note", "confidence"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "effects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/tag" }
          },
          "relevantTo": {
            "description": "Which of my champions this item matters against.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/championId" }
          },
          "note": { "type": "string", "minLength": 3, "maxLength": 200 },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
        }
      }
    }
  }
}
