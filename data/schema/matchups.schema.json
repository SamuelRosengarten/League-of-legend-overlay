{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-advisor.local/schema/matchups.schema.json",
  "title": "Curated matchups for one of my champions (data/matchups/<champion>.json)",
  "type": "object",
  "required": ["champion", "role", "threatWeights", "genericAdvice", "matchups"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "champion": { "$ref": "common.schema.json#/$defs/championId" },
    "role": { "$ref": "common.schema.json#/$defs/role" },
    "threatWeights": {
      "description": "How much each enemy tag adds to the threat score against my champion (0 = irrelevant, 3 = very relevant).",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/tag" },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 3 }
    },
    "genericAdvice": {
      "description": "Fallback advice for uncurated enemies, shown when the enemy has the tag.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/tag" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/text" }
    },
    "matchups": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/championId" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "phase": {
      "description": "Who is favored in this phase: \"me\" (my champion), \"them\" or \"even\".",
      "enum": ["me", "them", "even"]
    },
    "powerSpike": {
      "type": "object",
      "required": ["kind", "note"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["level", "item", "other"] },
        "level": { "type": "integer", "minimum": 1, "maximum": 18 },
        "item": { "$ref": "common.schema.json#/$defs/itemId" },
        "note": { "type": "string", "minLength": 3, "maxLength": 200 },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "level" } } }, "then": { "required": ["level"] } },
        { "if": { "properties": { "kind": { "const": "item" } } }, "then": { "required": ["item"] } }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "difficulty",
        "threat",
        "phaseAdvantage",
        "powerSpikes",
        "dangerAbilities",
        "tips",
        "itemAdjustments",
        "runeAdjustments",
        "threatTags",
        "lastReviewedPatch",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "difficulty": { "description": "1 = easy for me, 5 = very hard.", "type": "integer", "minimum": 1, "maximum": 5 },
        "threat": {
          "description": "Curated base threat of this enemy to my champion in the whole game (1-5), before tag weights.",
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "phaseAdvantage": {
          "type": "object",
          "required": ["early", "mid", "late"],
          "additionalProperties": false,
          "properties": {
            "early": { "$ref": "#/$defs/phase" },
            "mid": { "$ref": "#/$defs/phase" },
            "late": { "$ref": "#/$defs/phase" }
          }
        },
        "powerSpikes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/powerSpike" } },
        "dangerAbilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "name", "note"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "common.schema.json#/$defs/abilityKey" },
              "name": { "type": "string", "minLength": 2 },
              "note": { "type": "string", "minLength": 3, "maxLength": 200 },
              "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
            }
          }
        },
        "tips": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "common.schema.json#/$defs/text" } },
        "itemAdjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "note"],
            "additionalProperties": false,
            "properties": {
              "item": { "$ref": "common.schema.json#/$defs/itemId" },
              "name": { "type": "string", "minLength": 2 },
              "note": { "type": "string", "minLength": 3, "maxLength": 200 },
              "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
            }
          }
        },
        "runeAdjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rune", "note"],
            "additionalProperties": false,
            "properties": {
              "rune": { "type": "string", "minLength": 2 },
              "note": { "type": "string", "minLength": 3, "maxLength": 200 },
              "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
            }
          }
        },
        "threatTags": {
          "description": "Tags of this enemy that matter specifically against my champion (added to the generic tags).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/tag" }
        },
        "jungle": {
          "description": "Amumu only: how this enemy jungler affects the early path.",
          "type": "object",
          "required": ["invadeRisk", "strongLevels", "note"],
          "additionalProperties": false,
          "properties": {
            "invadeRisk": { "enum": ["low", "medium", "high"] },
            "strongLevels": {
              "description": "Levels at which this jungler is unusually strong in a skirmish (for invade warnings).",
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 6 }
            },
            "note": { "type": "string", "minLength": 3, "maxLength": 250 }
          }
        },
        "lastReviewedPatch": { "$ref": "common.schema.json#/$defs/patch" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "reviewNotes": {
          "description": "Free-form notes for the human reviewer (what is uncertain and why).",
          "type": "string"
        }
      }
    }
  }
}
