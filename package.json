    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "validate:data": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@fontsource/cinzel": "^5.3.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.5",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
