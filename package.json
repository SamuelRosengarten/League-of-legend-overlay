{
  "name": "rift-advisor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:mock": "cross-env RIFT_MOCK=1 tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
